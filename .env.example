# ==============================================================================
# CTRL A IT HUB - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env' on your server: cp .env.example .env
# Then update each value with your actual production secrets and domain.
# ==============================================================================

# --- DJANGO CORE SETTINGS ---
# Set DEBUG to False for production!
DEBUG=False

# Generate a strong 50+ character random string:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-50-characters

# Comma-separated list of hostnames or IP addresses allowed to serve the site
ALLOWED_HOSTS=ctrlaithub.com,www.ctrlaithub.com,127.0.0.1,localhost

# Required for Django 4.0+ HTTPS POST requests (logins, contact forms, enquiries)
CSRF_TRUSTED_ORIGINS=https://ctrlaithub.com,https://www.ctrlaithub.com

# Set to True once SSL/HTTPS certificate is installed with Certbot
SECURE_SSL_REDIRECT=True

# --- DATABASE CONFIGURATION ---
# Default is local SQLite:
DATABASE_URL=sqlite:///db.sqlite3
# For PostgreSQL (recommended for high traffic):
# DATABASE_URL=postgres://ctrla_user:StrongPassword123@localhost:5432/ctrla_db

# --- INITIAL ADMIN USER ---
# Used only when running 'python manage.py seed_data' for the first time
INITIAL_ADMIN_PASSWORD=SetAStrongPasswordHere123!

# --- EMAIL CONFIGURATION (GMAIL SMTP) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-institute-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-gmail-app-password
DEFAULT_FROM_EMAIL=your-institute-email@gmail.com

# --- CELERY & BACKGROUND TASKS (REDIS OPTIONAL) ---
# By default, NO Redis is needed! Tasks run directly in Python:
CELERY_TASK_ALWAYS_EAGER=True
CELERY_BROKER_URL=memory://
CELERY_RESULT_BACKEND=cache+memory://

# If you ever install/enable Redis in the future, uncomment these:
# CELERY_TASK_ALWAYS_EAGER=False
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0


# --- META WHATSAPP CLOUD API ---
# Permanent token and Phone ID from Meta Developer Portal
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_API_VERSION=v19.0

# Notification recipient phone numbers (international format without +)
ADMIN_NUMBER_401=919133391401
ADMIN_NUMBER_402=919133391402
ADMIN_NUMBER_152=919989985152

# --- GOOGLE ANALYTICS 4 ---
# Optional: GA4 Property ID (e.g., 123456789)
GA_PROPERTY_ID=
