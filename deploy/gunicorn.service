[Unit]
Description=Gunicorn daemon for CTRL A IT HUB
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/ctrl_a_it_hub
ExecStart=/var/www/ctrl_a_it_hub/venv/bin/gunicorn \
          --workers 3 \
          --bind unix:/run/gunicorn.sock \
          --access-logfile /var/log/gunicorn-access.log \
          --error-logfile /var/log/gunicorn-error.log \
          ctrla_hub.wsgi:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
